APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MAP_ENGINE=maplibre
MAP_CENTER_LATITUDE=-15.7801
MAP_CENTER_LONGITUDE=-47.9292
MAP_DEFAULT_ZOOM=4
MAP_BASE_STYLE_URL=
MAP_RASTER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_RASTER_DARK_TILE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
MAP_RASTER_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_MARTIN_ENABLED=true
MAP_MARTIN_TILEJSON_URL=/tiles
MARTIN_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/data
MARTIN_INTERNAL_CATALOG_URL=http://martin:3000/catalog

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_SEARCH_PATH=public,geo,climate,infrastructure,mobility,energy,internet
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# População oficial por setor censitário (IBGE Censo 2022, Mato Grosso)
IBGE_CENSUS_SECTORS_URL=https://ftp.ibge.gov.br/Censos/Censo_Demografico_2022/Agregados_por_Setores_Censitarios/malha_com_atributos/setores/gpkg/UF/MT/MT_setores_CD2022.gpkg

# Relevo 3D (tiles Terrarium RGB; pode apontar para uma fonte própria)
MAP_TERRAIN_ENABLED=true
MAP_TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
MAP_TERRAIN_ZOOM=12
MAP_TERRAIN_EXAGGERATION=1.35
MAP_TERRAIN_ATTRIBUTION="Mapzen Terrain Tiles / AWS Open Data"

# Construções locais do GlobalBuildingAtlas
GLOBAL_BUILDING_ATLAS_PATH=/var/www/html/storage/app/global-building-atlas
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_TIMEOUT=90
BUILDING_DEDUPLICATION_DISTANCE_DEGREES=0.00012
OSM_BUILDING_METERS_PER_LEVEL=3.0
OSM_BUILDING_DEFAULT_HEIGHT=6.0
OSM_BUILDING_MAX_BBOX_AREA=0.25
OSM_BUILDING_VIEWPORT_MAX_AREA=0.08
